{
  "name": "lifeform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"src/**/*.test.ts\"",
    "build:electron": "tsc -p electron --noEmit && node scripts/build-electron.mjs",
    "electron:dev": "concurrently -k -n next,electron \"next dev\" \"wait-on http-get://localhost:3000 && npm run build:electron && node scripts/start-electron.mjs\""
  },
  "dependencies": {
    "@smartspectra/node-sdk": "^3.4.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "main": "dist-electron/main.js"
}
